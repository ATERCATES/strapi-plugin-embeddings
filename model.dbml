// # definition.dbml — strapi-plugin-embeddings
// Versión: 2.0
// Autor: Javier (cliente)
// Fecha: 2025-10-30
// Changes: Simplified to 1 profile per content_type, added published flag for draft/published tracking

// Tables

/////////////////////////////////////////////////////

Table plugin_embeddings_profile {
  id uuid [pk, note: "Primary key"]
  content_type varchar(255) [unique, not null, note: "One profile per content type, e.g. api::article.article"]
  fields jsonb [not null, note: "JSON array of field paths to embed"]
  enabled boolean [not null, default: true, note: "Enable/disable embeddings"]
  auto_sync boolean [not null, default: true, note: "Auto-sync on content changes"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

/////////////////////////////////////////////////////

Table plugin_embeddings_vector {
  id uuid [pk, note: "Primary key"]
  content_type varchar(255) [not null, ref: > plugin_embeddings_profile.content_type, note: "Foreign key to profile, CASCADE on delete"]
  
  document_id varchar(255) [not null, note: "Strapi document_id (same for draft and published)"]
  cmp_id varchar(255) [null, note: "Component ID if field is inside a component"]
  field varchar(255) [not null, note: "Field path being embedded"]
  
  content text [not null, note: "Exact copy of the content from which the embedding was generated"]
  embedding vector(1536) [not null, note: "OpenAI embedding vector (1536 dimensions)"]
  published boolean [not null, default: false, note: "false=draft, true=published"]
  
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  
  indexes {
    (content_type, document_id, field, published) [unique, name: 'idx_vector_upsert']
    document_id [name: 'idx_vector_document']
    (document_id, published) [name: 'idx_vector_doc_state']
    content_type [name: 'idx_vector_content_type']
    embedding [name: 'idx_vector_search_published']
  }
}