{
  "openapi": "3.0.3",
  "info": {
    "title": "Strapi Embeddings Plugin API",
    "description": "API documentation for the Strapi Embeddings Plugin - providing AI embeddings and semantic search functionality using OpenAI and pgvector (PostgreSQL vector extension).",
    "version": "1.0.0",
    "contact": {
      "name": "Strapi Embeddings Plugin",
      "url": "https://github.com/ATERCATES/strapi-plugin-embeddings"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:1337/api/embeddings",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "Profiles",
      "description": "Profile management endpoints - Configure which content types and fields to embed"
    },
    {
      "name": "Search",
      "description": "Semantic search endpoints - Search content using AI-powered vector similarity"
    }
  ],
  "paths": {
    "/profiles": {
      "get": {
        "tags": ["Profiles"],
        "summary": "List all profiles",
        "description": "Retrieves a list of all embedding profiles configured in the system. Profiles define which content types and fields are indexed for semantic search.",
        "operationId": "listProfiles",
        "responses": {
          "200": {
            "description": "Successfully retrieved profiles",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Profile"
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "total": {
                          "type": "integer",
                          "description": "Total number of profiles"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "data": [
                    {
                      "id": "uuid",
                      "content_type": "string",
                      "fields": [
                        "field_name",
                        "nested.field_name"
                      ],
                      "enabled": true,
                      "auto_sync": true,
                      "created_at": "2025-11-05T11:49:50.777Z",
                      "updated_at": "2025-11-05T11:49:50.777Z"
                    }
                  ],
                  "meta": {
                    "total": 1
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/search": {
      "get": {
        "tags": ["Search"],
        "summary": "Global semantic search",
        "description": "Performs semantic search across all enabled profiles. Returns documents that are semantically similar to the query text, sorted by similarity score. This endpoint searches across all content types that have active embedding profiles.",
        "operationId": "search",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "The search query text. This will be converted to an embedding and compared against stored document embeddings.",
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "example": "artificial intelligence in healthcare"
          },
          {
            "name": "top_k",
            "in": "query",
            "required": false,
            "description": "Maximum number of results to return. Must be between 1 and 1000.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 10
            },
            "example": 10
          },
          {
            "name": "minScore",
            "in": "query",
            "required": false,
            "description": "Minimum similarity score threshold (0-1). Results below this score will be filtered out. Higher values return more relevant results.",
            "schema": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0
            },
            "example": 0.7
          },
          {
            "name": "populate",
            "in": "query",
            "required": false,
            "description": "Whether to populate relations. Use 'true' to populate all relations.",
            "schema": {
              "type": "string",
              "enum": ["true", "false"]
            },
            "example": "true"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "description": "Array of documents matching the search query",
                      "items": {
                        "type": "object",
                        "description": "Document structure varies by content type"
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "total": {
                          "type": "integer",
                          "description": "Total number of results returned"
                        },
                        "score": {
                          "type": "object",
                          "description": "Similarity score statistics",
                          "properties": {
                            "min": {
                              "type": "number",
                              "description": "Minimum similarity score"
                            },
                            "max": {
                              "type": "number",
                              "description": "Maximum similarity score"
                            },
                            "avg": {
                              "type": "number",
                              "description": "Average similarity score"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "data": [
                    {
                      "id": 1,
                      "documentId": "abc123",
                      "title": "AI in Healthcare: A Comprehensive Guide",
                      "description": "Exploring artificial intelligence applications in modern medicine",
                      "publishedAt": "2024-01-15T10:30:00.000Z"
                    }
                  ],
                  "meta": {
                    "total": 1,
                    "score": {
                      "min": 0.85,
                      "max": 0.85,
                      "avg": 0.85
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/{contentType}/search": {
      "get": {
        "tags": ["Search"],
        "summary": "Search by content type",
        "description": "Performs semantic search within a specific content type. Returns documents of the specified content type that are semantically similar to the query text. The content type must have an active embedding profile.",
        "operationId": "searchByContentType",
        "parameters": [
          {
            "name": "contentType",
            "in": "path",
            "required": true,
            "description": "The content type to search within (e.g., 'article', 'product', 'post'). Must match a configured profile's content type without the 'api::' prefix and collection name.",
            "schema": {
              "type": "string"
            },
            "example": "article"
          },
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "The search query text. This will be converted to an embedding and compared against stored document embeddings.",
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "example": "machine learning algorithms"
          },
          {
            "name": "top_k",
            "in": "query",
            "required": false,
            "description": "Maximum number of results to return. Must be between 1 and 1000.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 10
            },
            "example": 5
          },
          {
            "name": "minScore",
            "in": "query",
            "required": false,
            "description": "Minimum similarity score threshold (0-1). Results below this score will be filtered out.",
            "schema": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0
            },
            "example": 0.75
          },
          {
            "name": "embeddingField",
            "in": "query",
            "required": false,
            "description": "Filter results by specific embedding field(s). Can be a single field name or multiple fields. Only embeddings from these fields will be searched.",
            "schema": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "examples": {
              "singleField": {
                "value": "title",
                "summary": "Search only in title field"
              },
              "multipleFields": {
                "value": ["title", "description"],
                "summary": "Search in title and description fields"
              }
            }
          },
          {
            "name": "populate",
            "in": "query",
            "required": false,
            "description": "Relations to populate. Can be specific relation names or '*' for all relations.",
            "schema": {
              "type": "string"
            },
            "example": "*"
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Specific fields to return in the response. Comma-separated list.",
            "schema": {
              "type": "string"
            },
            "example": "title,description,publishedAt"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "description": "Array of documents matching the search query",
                      "items": {
                        "type": "object",
                        "description": "Document structure varies by content type"
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "total": {
                          "type": "integer",
                          "description": "Total number of results returned"
                        },
                        "score": {
                          "type": "object",
                          "description": "Similarity score statistics",
                          "properties": {
                            "min": {
                              "type": "number",
                              "description": "Minimum similarity score"
                            },
                            "max": {
                              "type": "number",
                              "description": "Maximum similarity score"
                            },
                            "avg": {
                              "type": "number",
                              "description": "Average similarity score"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "data": [
                    {
                      "id": 1,
                      "documentId": "xyz789",
                      "title": "Understanding Machine Learning",
                      "description": "A beginner's guide to ML algorithms",
                      "publishedAt": "2024-02-20T14:15:00.000Z"
                    }
                  ],
                  "meta": {
                    "total": 1,
                    "score": {
                      "min": 0.82,
                      "max": 0.82,
                      "avg": 0.82
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "description": "Profile is disabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "status": 403,
                    "name": "ForbiddenError",
                    "message": "Profile for content type article is disabled"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Profile not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "status": 404,
                    "name": "NotFoundError",
                    "message": "No profile found for content type: article"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Profile": {
        "type": "object",
        "description": "An embedding profile configuration that defines which content type and fields should be indexed for semantic search",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the profile"
          },
          "content_type": {
            "type": "string",
            "description": "The content type identifier (can be a Strapi UID like 'api::article.article' or a custom identifier)",
            "example": "ai-content"
          },
          "fields": {
            "type": "array",
            "description": "List of field names to generate embeddings for. Can include nested component fields using dot notation (e.g., 'sections.content', 'question_variants.question_variant')",
            "items": {
              "type": "string"
            },
            "example": ["title", "description", "content", "sections.text", "question_variants.question_variant"]
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the profile is active. Disabled profiles won't generate new embeddings or be searchable",
            "default": true
          },
          "auto_sync": {
            "type": "boolean",
            "description": "Whether to automatically generate embeddings when documents are created or updated",
            "default": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Profile creation timestamp"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Profile last update timestamp"
          }
        },
        "required": ["id", "content_type", "fields", "enabled", "auto_sync"]
      },
      "Error": {
        "type": "object",
        "description": "Standard error response format",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              },
              "name": {
                "type": "string",
                "description": "Error name/type"
              },
              "message": {
                "type": "string",
                "description": "Human-readable error message"
              }
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request - Invalid parameters",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "missingQuery": {
                "summary": "Missing required query parameter",
                "value": {
                  "error": {
                    "status": 400,
                    "name": "BadRequestError",
                    "message": "query parameter is required"
                  }
                }
              },
              "invalidTopK": {
                "summary": "Invalid top_k parameter",
                "value": {
                  "error": {
                    "status": 400,
                    "name": "BadRequestError",
                    "message": "The top_k parameter must be between 1 and 1000"
                  }
                }
              },
              "invalidMinScore": {
                "summary": "Invalid minScore parameter",
                "value": {
                  "error": {
                    "status": 400,
                    "name": "BadRequestError",
                    "message": "The minScore parameter must be between 0 and 1"
                  }
                }
              },
              "invalidEmbeddingField": {
                "summary": "Invalid embeddingField parameter",
                "value": {
                  "error": {
                    "status": 400,
                    "name": "BadRequestError",
                    "message": "embeddingField must be a string or array of strings"
                  }
                }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "status": 404,
                "name": "NotFoundError",
                "message": "Profile not found"
              }
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "status": 500,
                "name": "InternalServerError",
                "message": "An unexpected error occurred"
              }
            }
          }
        }
      }
    }
  }
}
